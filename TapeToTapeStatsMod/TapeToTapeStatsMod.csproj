<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>TapeToTapeStatsMod</RootNamespace>
		<AssemblyName>TapeToTapeStatsMod</AssemblyName>
		<Version>1.0.0</Version>
		<NeutralLanguage>en-US</NeutralLanguage>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- The game and MelonLoader are x64-only. -->
		<PlatformTarget>x64</PlatformTarget>
		<!-- Game assemblies are provided by MelonLoader at runtime; never copy them to bin. -->
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<!--
		Location of the Tape to Tape install (with MelonLoader installed and run once).
		Override per machine with any of:
		  - the TAPE_TO_TAPE_DIR environment variable
		  - dotnet build -p:GamePath="..."
		  - a GamePath property in TapeToTapeStatsMod.csproj.user (gitignored)
	-->
	<PropertyGroup>
		<GamePath Condition="'$(GamePath)' == '' And '$(TAPE_TO_TAPE_DIR)' != ''">$(TAPE_TO_TAPE_DIR)</GamePath>
		<GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Tape to Tape</GamePath>
		<!-- Copy the built mod into the game's Mods folder after each build. -->
		<DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="$(GamePath)\MelonLoader\net6\MelonLoader.dll" Private="false" />
		<Reference Include="$(GamePath)\MelonLoader\net6\0Harmony.dll" Private="false" />
		<Reference Include="$(GamePath)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
		<Reference Include="$(GamePath)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
		<Reference Include="$(GamePath)\MelonLoader\net6\Newtonsoft.Json.dll" Private="false" />
		<Reference Include="$(GamePath)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
	</ItemGroup>

	<Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(GamePath)\MelonLoader\Il2CppAssemblies')"
			Text="MelonLoader Il2Cpp assemblies not found under '$(GamePath)'. Install MelonLoader, launch the game once, and set GamePath (see apps/mod/README.md)." />
	</Target>

	<Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" />
		<Message Importance="high" Text="Deployed $(TargetFileName) to $(GamePath)\Mods" />
	</Target>
</Project>
